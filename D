from ltv_helpers import pipeline_helpers as ph

new_path = p.risk_prem_float
old_path = new_path.replace("release/NB_Classic_SPL_v10.0.0", "release/NB_Classic_SPL_v9.4.1")
print("v10:  ", new_path, stat(new_path))
print("9.4.1:", old_path, stat(old_path))


new = ph.read_parquet_s3(spark, new_path).toPandas()
old = ph.read_parquet_s3(spark, old_path).toPandas()

print("rows:", old.shape[0], "->", new.shape[0])
print("column differences:", set(old.columns) ^ set(new.columns))

keys = [c for c in new.columns if new[c].dtype == object]   # text columns as keys (state, line, etc.)
nums = [c for c in new.columns if c not in keys and c in old.columns]
print("keys:", keys)

m = old.merge(new, on=keys, how="outer", suffixes=("_941", "_v10"), indicator=True)
print(m["_merge"].value_counts())

for c in nums:
    d = (m[f"{c}_v10"] - m[f"{c}_941"]).abs()
    print(f"{c}: rows different = {(d > 1e-9).sum()}, max abs diff = {d.max()}")
