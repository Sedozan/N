def read(fname):
    with open(f"{CODE}/{fname}", encoding="utf-8-sig") as fh:
        return fh.read()

def assert_import_safe(fname):
    """Fail if the file calls anything at top level, since importing would run it."""
    for node in ast.parse(read(fname)).body:
        if isinstance(node, ast.Expr) and isinstance(node.value, ast.Call):
            raise AssertionError(f"{fname}: top-level call on line {node.lineno}")

def load(fname):
    assert_import_safe(fname)
    spec = importlib.util.spec_from_file_location(fname[:-3], f"{CODE}/{fname}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

def to_spark(df):
    return df if hasattr(df, "exceptAll") else spark.createDataFrame(df)


