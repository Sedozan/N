import pandas as pd

def scan_xlsx(f):
    local = "/lakehouse/default/Files/" + f.path.split("/Files/", 1)[1]
    for name, s in pd.read_excel(local, sheet_name=None, dtype=str).items():
        s = s.fillna("")
        condo = s.apply(lambda c: c.str.lower().str.contains("condo")).to_numpy().sum()
        line_cols = [c for c in s.columns if "line" in str(c).lower()]
        l78 = sum((s[c].str.strip() == "78").sum() for c in line_cols)
        hdr = [c for c in s.columns if "condo" in str(c).lower() or str(c).strip() == "78"]
        n = condo + l78 + len(hdr)
        print(f"{'HIT' if n else 'ok':6} {f.name}[{name}] cells={condo + l78} headers={hdr}")

