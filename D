def compare(base_path, after_path, drop=(), line_col="line"):
    b = spark.read.format("delta").load(base_path)
    a = spark.read.format("delta").load(after_path)
    drop = [c for c in drop if c in b.columns]
    b, a = b.drop(*drop), a.drop(*drop)
    assert set(b.columns) == set(a.columns), set(b.columns) ^ set(a.columns)
    a = a.select(*b.columns)
    is78 = F.lower(F.col(line_col).cast("string")).isin("78", "condo")
    assert a.filter(is78).count() == 0, "line 78 still in output"
    b = b.filter(~is78)
    only_b, only_a = b.exceptAll(a).count(), a.exceptAll(b).count()
    print(f"rows base={b.count()} after={a.count()} | only in base={only_b} only in after={only_a}")
    if only_b or only_a:  # find which columns differ
        for c in b.columns:
            if b.select(c).exceptAll(a.select(c)).count():
                print("  differs:", c)
    return only_b == 0 and only_a == 0

