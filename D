# ---------------- load ----------------
fabric_scores = fh.read_delta_table(spark, FABRIC_PUBLIC_RESULTS).toPandas()
domino_scores = spark.read.format("parquet").load(DOMINO_PUBLIC_RESULTS).toPandas()

print(f"\nfabric rows: {len(fabric_scores):,}")
print(f"domino rows: {len(domino_scores):,}")

# ---------------- key integrity ----------------
def key_report(df, name):
    missing = [k for k in JOIN_KEYS if k not in df.columns]
    if missing:
        raise KeyError(f"{name} is missing join key column(s): {missing}")
    print(
        f"{name:7s} rows={len(df):>10,}"
        f"  unique_keys={len(df[JOIN_KEYS].drop_duplicates()):>10,}"
        f"  dup_rows={int(df.duplicated(subset=JOIN_KEYS).sum()):>8,}"
        f"  null_keys={int(df[JOIN_KEYS].isna().any(axis=1).sum()):>8,}"
    )

print()
key_report(fabric_scores, "fabric")
key_report(domino_scores, "domino")

# ---------------- coverage by release date (before joining) ----------------
fk = fabric_scores[JOIN_KEYS].assign(fab=1)
dk = domino_scores[JOIN_KEYS].assign(dom=1)
k = fk.merge(dk, on=JOIN_KEYS, how="outer")
k["side"] = np.select([k["fab"].isna(), k["dom"].isna()], ["domino_only", "fabric_only"], "both")
print()
print(k.groupby(["release_date", "side"]).size().unstack(fill_value=0).tail(15))
