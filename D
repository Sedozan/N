def stat(path):
    """Last modified time and size for a file or a parquet folder."""
    path = path if path.startswith("s3a://") else f"s3a://{path}"
    jp = spark._jvm.org.apache.hadoop.fs.Path(path)
    fs = jp.getFileSystem(spark._jsc.hadoopConfiguration())
    if not fs.exists(jp):
        return None, None
    st = fs.getFileStatus(jp)
    files = [st] if st.isFile() else [f for f in fs.listStatus(jp) if f.isFile()]
    mtime = max(f.getModificationTime() for f in files)
    size = sum(f.getLen() for f in files)
    return datetime.fromtimestamp(mtime / 1000), size



