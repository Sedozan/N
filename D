def ls(path):
    path = path if path.startswith("s3a://") else f"s3a://{path}"
    jp = spark._jvm.org.apache.hadoop.fs.Path(path)
    fs = jp.getFileSystem(spark._jsc.hadoopConfiguration())
    if not fs.exists(jp):
        print("  does not exist:", path); return
    for f in fs.listStatus(jp):
        print(f"  {f.getPath().getName():45} {datetime.fromtimestamp(f.getModificationTime()/1000)}  {f.getLen()}")

