def funcs(mod):
    return {n: f for n, f in vars(mod).items()
            if isinstance(f, types.FunctionType) and f.__module__ == mod.__name__}

def reads_global(fn, names):
    stack = [fn.__code__]
    while stack:
        co = stack.pop()
        if set(names) & set(co.co_names):
            return True
        stack += [c for c in co.co_consts if isinstance(c, types.CodeType)]
    return False

EXPECTED_CHANGED = {"1_policy": {"get_lr_nt6_by_line"}, "driver_loss_balance": set()}
EDITED = ["lines", "line_mapping", "spl_lr_fits"]

for label, old, new in [("1_policy", op, np1), ("driver_loss_balance", ob, nb)]:
    fo_, fn_ = funcs(old), funcs(new)
    assert fo_.keys() == fn_.keys(), (label, fo_.keys() ^ fn_.keys())
    changed = {n for n in fo_ if inspect.getsource(fo_[n]) != inspect.getsource(fn_[n])}
    assert changed == EXPECTED_CHANGED[label], (label, changed)
    deps = sorted(n for n, f in fn_.items() if reads_global(f, EDITED))
    print(f"{label}: changed bodies = {sorted(changed)}; functions reading edited constants = {deps}")

