from types import SimpleNamespace as NS

paths = {a: getattr(p, a) for a in dir(p)
         if not a.startswith("_") and any(k in a.lower() for k in ["balance", "risk"])}

for a, path in paths.items():
    if not notebookutils.fs.exists(path):
        print(f"MISSING {a}"); continue
    df = load(NS(name=path.split("/")[-1], path=path))
    if df is None:
        print(f"SKIP   {a}"); continue
    cols = [c for c in df.columns if any(k in c.lower() for k in ["line", "lob"])]
    if not cols:
        print(f"NOCOL  {a}: {df.columns[:12]}"); continue
    for c in cols:
        n = df.filter(F.lower(F.col(c).cast("string"))
                      .isin("78", "condo", "condominiums")).count()
        print(f"{'HIT' if n else 'ok':6} {a} {c} {n}")
