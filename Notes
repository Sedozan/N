import subprocess
import nbformat as nbf

p = "notebooks/classic_spl_component_making.ipynb"
old_text = subprocess.run(
    ["git", "show", f"HEAD~1:{p}"],
    capture_output=True, check=True,
).stdout.decode("utf-8")
old = nbf.reads(old_text, as_version=4)
new = nbf.read(p, as_version=4)

for c in new.cells:
    c.metadata = {}
    if c.cell_type == "code":
        c.outputs = []
        c.execution_count = None

new.metadata = old.metadata
nbf.write(new, p)
print(f"{len(new.cells)} cells written")




cd C:\Users\ssenp\repos\f_classic_specialty_clv
pip install nbformat
python $HOME\tidy_nb.py
